---
/**
 * Band mark: the vector logo (traced from the band's artwork). `compact` shows the name
 * only, for small sizes.
 */
import LogoMark from '@/components/ui/LogoMark.astro';

interface Props {
  /** Rendered height in pixels; omit to size it with CSS. */
  height?: number;
  compact?: boolean;
  animated?: boolean;
  class?: string;
}

const { height, compact = false, animated = false, class: className } = Astro.props;
---

<LogoMark height={height} compact={compact} animated={animated} class={className} />
