---
import creditMark from '@/assets/credit/samuele-cieri-mark.png';
import Icon from '@/components/ui/Icon.astro';
import { copy } from '@/config/copy';
import { isTodo, nav, showTodo, site, TODO } from '@/config/site';
import Brand from './Brand.astro';

const year = new Date().getFullYear();
const links = [...nav, { label: 'Archivio date', href: '/archivio/' }];
---

<footer class="border-t border-line bg-night-900">
  <div class="wrap grid gap-10 py-12 md:grid-cols-3 md:py-16">
    <div class="grid content-start gap-3">
      <Brand height={44} compact />
      <p class="label text-mute">{site.subtitle}</p>
      <p class="text-sm text-mute">
        {`${site.area.cities.join(', ')} ${site.area.note}.`}
      </p>
    </div>

    <nav id="navigazione" aria-label="Pagine del sito" tabindex="-1">
      <h2 class="label mb-3 text-red-ink">{copy.ui.navTitle}</h2>
      <ul class="grid grid-cols-2 gap-x-6">
        {
          links.map((item) => (
            <li>
              <a class="footer-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="label mb-3 text-red-ink">{copy.ui.contactsTitle}</h2>
      <ul>
        <li>
          <a class="footer-link" href={site.contact.phoneHref}>
            <Icon name="phone" />
            {site.contact.phoneDisplay}
          </a>
        </li>
        {
          (!isTodo(site.contact.email) || showTodo()) && (
            <li>
          {
            isTodo(site.contact.email) ? (
              <span class="footer-link">
                <Icon name="mail" />
                <span class="todo">{TODO} email</span>
              </span>
            ) : (
              <a class="footer-link" href={`mailto:${site.contact.email}`}>
                <Icon name="mail" />
                {site.contact.email}
              </a>
            )
          }
            </li>
          )
        }
        <li>
          <a class="footer-link" href={site.social.instagram.url} rel="noopener noreferrer">
            <Icon name="instagram" />
            Instagram
            <span class="visually-hidden">: {site.social.instagram.handle}</span>
          </a>
        </li>
        <li>
          <a class="footer-link" href={site.social.facebook.url} rel="noopener noreferrer">
            <Icon name="facebook" />
            Facebook
            <span class="visually-hidden">: {site.social.facebook.handle}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="wrap grid gap-2 py-6 text-xs text-mute md:flex md:items-center md:justify-between">
      <p>{site.disclaimer}</p>
      <p class="flex grow flex-wrap items-center gap-x-4 md:grow-0">
        <span>© {year} {site.name}</span>
        <a class="footer-link underline underline-offset-4" href="/privacy/">Privacy</a>
        <a class="footer-link underline underline-offset-4" href="/accessibilita/">Accessibilità</a>
        {/* The author's signature: a small monochrome mark that blends in with the footer. */}
        <a
          class="signature"
          href={site.credit.url}
          rel="noopener noreferrer"
          aria-label={`${copy.ui.creditLabel} ${site.credit.name}`}
          title={`${copy.ui.creditLabel} ${site.credit.name}`}
        >
          <span class="signature-mark" style={`--mark: url(${creditMark.src})`} aria-hidden="true" />
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--color-bone);
  }

  .signature {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    color: var(--color-mute);
    opacity: 0.5;
    transition:
      opacity var(--duration-fast) linear,
      color var(--duration-fast) linear;
  }

  /* The mark is a mask: it takes the colour of the text around it. */
  .signature-mark {
    display: block;
    width: 2rem;
    aspect-ratio: 133 / 96;
    background: currentColor;
    -webkit-mask: var(--mark) center / contain no-repeat;
    mask: var(--mark) center / contain no-repeat;
  }

  .signature:hover,
  .signature:focus-visible {
    color: var(--color-red-ink);
    opacity: 1;
  }

  a.footer-link:hover {
    color: var(--color-red-ink);
  }
</style>
