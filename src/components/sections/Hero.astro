---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Brand from '@/components/layout/Brand.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import LightningSVG from '@/components/ui/LightningSVG.astro';
import Storm from '@/components/ui/Storm.astro';
import { copy } from '@/config/copy';
import { images } from '@/config/images';
import { site } from '@/config/site';
import type { EventEntry } from '@/lib/content';
import { dateParts } from '@/lib/dates';
import { placeLabel } from '@/lib/events';

interface Props {
  next: EventEntry | undefined;
}

const { next } = Astro.props;
const nextDate = next ? dateParts(next.data.date) : null;

// Art direction: a vertical crop for phones, a horizontal one from 48rem up.
const DESKTOP = '(min-width: 48rem)';
const { mobile, desktop } = images.hero;
const srcset = async (src: ImageMetadata, format: 'avif' | 'webp', widths: number[]) =>
  (await getImage({ src, format, widths })).srcSet.attribute;
const sources = [
  { media: DESKTOP, type: 'image/avif', srcset: await srcset(desktop.src, 'avif', [1280, 1920, 2400]) },
  { media: DESKTOP, type: 'image/webp', srcset: await srcset(desktop.src, 'webp', [1280, 1920, 2400]) },
  { media: undefined, type: 'image/avif', srcset: await srcset(mobile.src, 'avif', [480, 720, 1080]) },
  { media: undefined, type: 'image/webp', srcset: await srcset(mobile.src, 'webp', [480, 720, 1080]) },
];
const fallback = await getImage({ src: mobile.src, format: 'jpg', width: 720 });
const { video } = site.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="media">
    <picture>
      {sources.map((source) => <source media={source.media} type={source.type} srcset={source.srcset} sizes="100vw" />)}
      <img
        src={fallback.src}
        alt={mobile.alt}
        width={mobile.src.width}
        height={mobile.src.height}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>
    {
      video.enabled && (
        <video
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          tabindex="-1"
          data-hero-video
          data-mobile-webm={video.mobile.webm}
          data-mobile-mp4={video.mobile.mp4}
          data-desktop-webm={video.desktop.webm}
          data-desktop-mp4={video.desktop.mp4}
        />
      )
    }
  </div>
  <div class="shade" aria-hidden="true"></div>
  <div class="beams" aria-hidden="true">
    <span class="beam beam-a"></span>
    <span class="beam beam-b"></span>
  </div>
  <LightningSVG variant="a" class="hero-bolt" />
  <Storm />

  <div class="wrap content">
    <h1 id="hero-title" class="title" data-ignite>
      <Brand pixelWidth={1000} class="logo" />
      <span class="poster subtitle">{site.subtitle}</span>
    </h1>
    <p class="claim">
      {copy.hero.claim}
      <span class="area">{`${copy.hero.areaPrefix} ${site.area.cities.join(', ')} ${site.area.note}.`}</span>
    </p>

    {
      next && nextDate && (
        <a class="next" href="#prossimo">
          <span class="label text-red-ink">{copy.hero.nextLabel}</span>
          <span class="poster next-date">
            {nextDate.day} {nextDate.month}
          </span>
          <span class="next-place">
            {next.data.venue}, {placeLabel(next.data)}
          </span>
          <Icon name="arrow" class="next-arrow" />
        </a>
      )
    }

    <div class="cta">
      <Button href="/#tour" size="lg">{copy.hero.ctaFans}</Button>
      <Button href="/booking/" size="lg" variant="outline">{copy.hero.ctaBooking}</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: calc(100svh - 3.5rem);
    overflow: hidden;
    isolation: isolate;
  }

  .media,
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .media :global(img),
  .media :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shade {
    background:
      linear-gradient(to top, var(--color-night-950) 6%, rgb(4 6 12 / 0.82) 42%, rgb(4 6 12 / 0.25) 78%),
      linear-gradient(100deg, rgb(4 6 12 / 0.75), transparent 70%);
  }

  .content {
    display: grid;
    gap: 1.1rem;
    padding-block: 5rem 2rem;
  }

  .title {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }

  .wordmark {
    /* Text may run past the right edge on purpose; the hero clips it. */
    font-size: var(--text-mega);
    line-height: 0.8;
    white-space: nowrap;
  }

  .subtitle {
    padding: 0.2em 0.5em 0.15em;
    background: var(--color-red);
    font-size: var(--text-xl);
    line-height: 1;
    transform: rotate(-2deg);
    transform-origin: left center;
  }

  .area {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-mute);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.4;
  }

  .claim {
    max-width: 22ch;
    margin-top: 0.5rem;
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.15;
  }

  .next {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0 0.9rem;
    max-width: 34rem;
    min-height: 4rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-red);
    background: rgb(8 12 24 / 0.86);
  }

  .next .label {
    grid-column: 1 / -1;
  }

  .next-date {
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .next-place {
    min-width: 0;
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  .next:active {
    border-color: var(--color-red);
  }

  .cta {
    display: grid;
    gap: 0.75rem;
  }

  .hero :global(.hero-bolt) {
    position: absolute;
    top: 4%;
    right: 6%;
    z-index: -1;
    width: clamp(4rem, 16vw, 11rem);
    opacity: 0.9;
  }

  @media (min-width: 40rem) {
    .cta {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      min-height: calc(100svh - 4rem);
    }

    .content {
      padding-bottom: 4rem;
    }
  }
</style>
