---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import VolumeKnob from '@/components/ui/VolumeKnob.astro';
import { copy } from '@/config/copy';
import { getSetlist } from '@/lib/content';
import { fill } from '@/lib/text';

interface Props {
  /** The home page lists the first songs and folds the rest away. */
  limit?: number;
}

const { limit } = Astro.props;
const setlist = await getSetlist();
const songs = setlist?.data.songs ?? [];
const shown = limit ? songs.slice(0, limit) : songs;
const folded = limit ? songs.slice(limit) : [];
---

{
  setlist && (
    <section id="scaletta" data-word={copy.setlist.word} class="section grille" aria-labelledby="scaletta-title">
      <div class="wrap grid gap-10">
        <VolumeKnob class="justify-self-end" />
        <SectionHeading
          id="scaletta-title"
          eyebrow={copy.setlist.eyebrow}
          title={copy.setlist.title}
          intro={copy.setlist.intro}
        />
        <ol class="songs poster">
          {shown.map((song) => (
            <li data-reveal="rise">
              <span>{song}</span>
            </li>
          ))}
        </ol>
        {folded.length > 0 && (
          <details class="rest">
            <summary>{fill(copy.setlist.more, { count: String(folded.length) })}</summary>
            <ol class="songs poster" start={shown.length + 1} style={`counter-reset: song ${shown.length}`}>
              {folded.map((song) => (
                <li>
                  <span>{song}</span>
                </li>
              ))}
            </ol>
          </details>
        )}
        {setlist.data.note && <p class="text-sm text-mute">{setlist.data.note}</p>}
      </div>
    </section>
  )
}

<style>
  .songs {
    counter-reset: song;
    column-gap: 3rem;
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .songs li {
    display: grid;
    grid-template-columns: 2.2ch 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--color-line);
    break-inside: avoid;
    counter-increment: song;
  }

  .songs li::before {
    content: counter(song, decimal-leading-zero);
    color: var(--color-red-ink);
    font-size: 0.55em;
  }

  .rest summary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--color-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .rest[open] summary {
    margin-bottom: 1rem;
  }

  @media (min-width: 48rem) {
    .songs {
      columns: 2;
    }
  }

  @media (min-width: 80rem) {
    .songs {
      columns: 3;
    }
  }
</style>
