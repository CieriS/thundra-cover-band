---
import Button from '@/components/ui/Button.astro';
import Motif from '@/components/ui/Motif.astro';
import RevealText from '@/components/ui/RevealText.astro';
import { copy } from '@/config/copy';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';

interface Props {
  /** Home page: the social profiles close the page here instead of in a section of their own. */
  social?: boolean;
}

const { social = false } = Astro.props;
const { instagram, facebook } = site.social;
---

<section class="final" aria-labelledby="final-title">
  <div class="ghost poster" aria-hidden="true" data-text={site.name}></div>
  <div class="cannons" aria-hidden="true" data-reveal="pulse">
    <Motif name="cannon" />
    <Motif name="cannon" class="is-right" />
  </div>
  <div class="wrap grid gap-6">
    <RevealText id="final-title" lines={copy.finalCta.title} class="text-5xl" />
    <p class="max-w-md text-lg font-semibold">{copy.finalCta.text}</p>
    <div class="grid gap-3 sm:flex sm:flex-wrap">
      <Button href="/date/" size="lg" variant="outline">{copy.hero.ctaFans}</Button>
      <Button href="/booking/" size="lg" variant="ghost">{copy.hero.ctaBooking}</Button>
    </div>
    {
      social && (
        <div id="social" class="grid gap-3">
          <p class="max-w-md font-semibold">{copy.social.text}</p>
          <p class="flex flex-wrap gap-x-6 gap-y-1">
            {[instagram, facebook].map((profile, index) => (
              <a class="profile" href={profile.url} rel="noopener noreferrer">
                <Icon name={index === 0 ? 'instagram' : 'facebook'} />
                {profile.label}
                <span class="visually-hidden">: {profile.handle}</span>
              </a>
            ))}
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .final {
    position: relative;
    /* Slides under the previous section so the diagonal cut shows it, not the page background. */
    margin-top: calc(var(--slant) * -1);
    padding-block: calc(var(--spacing-section) + var(--slant));
    overflow: clip;
    background: var(--color-red);
    clip-path: polygon(0 var(--slant), 100% 0, 100% 100%, 0 100%);
    isolation: isolate;
  }

  .profile {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  /*
   * Oversized band name running off both edges, as a graphic layer.
   * Drawn as generated content: it is decoration, not text to be read.
   */
  .ghost::before {
    content: attr(data-text);
  }

  .ghost {
    position: absolute;
    right: -4vw;
    bottom: -0.16em;
    z-index: -1;
    color: var(--color-red-deep);
    font-size: clamp(8rem, 38vw, 34rem);
    line-height: 0.8;
    white-space: nowrap;
    opacity: 0.55;
  }
</style>
