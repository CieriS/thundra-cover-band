---
import { getImage } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import ResponsiveImage from '@/components/ui/ResponsiveImage.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { copy } from '@/config/copy';
import { fallbacks, pickFallback } from '@/config/images';
import { getGallery } from '@/lib/content';

const { gallery } = copy;
const photos = await Promise.all(
  (await getGallery()).map(async (entry, index) => {
    const src = entry.data.image ?? pickFallback(fallbacks.gallery, index);
    const full = await getImage({ src, format: 'webp', width: Math.min(1600, src.width) });
    return { src, full: full.src, alt: entry.data.alt, caption: entry.data.caption, placeholder: !entry.data.image };
  }),
);
---

{
  photos.length > 0 && (
    <section id="galleria" class="section" aria-labelledby="galleria-title">
      <div class="wrap grid gap-10">
        <SectionHeading id="galleria-title" eyebrow={gallery.eyebrow} title={gallery.title} />

        <ul class="grid-photos">
          {photos.map((photo, index) => (
            <li>
              {/* Without JavaScript the link opens the full image. */}
              <a
                href={photo.full}
                data-lightbox
                data-caption={photo.caption ?? ''}
                data-alt={photo.alt}
                aria-label={`${gallery.open}: ${photo.alt}`}
              >
                <ResponsiveImage
                  src={photo.src}
                  alt={photo.alt}
                  ratio={index % 5 === 0 ? '3 / 2' : '1 / 1'}
                  sizes={index % 5 === 0 ? '(min-width: 64rem) 66vw, 100vw' : '(min-width: 64rem) 33vw, 50vw'}
                  placeholder={photo.placeholder}
                  reveal
                />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <dialog class="lightbox" data-lightbox-dialog aria-label={gallery.eyebrow}>
        <figure>
          <img alt="" data-lightbox-image />
          <figcaption data-lightbox-caption />
        </figure>
        <div class="controls">
          <button type="button" data-lightbox-prev>
            <Icon name="arrow" class="flip" />
            <span class="visually-hidden">{gallery.previous}</span>
          </button>
          <p class="label" data-lightbox-count aria-live="polite" />
          <button type="button" data-lightbox-next>
            <Icon name="arrow" />
            <span class="visually-hidden">{gallery.next}</span>
          </button>
          <button type="button" class="close" data-lightbox-close>
            <Icon name="close" />
            <span class="label">{gallery.close}</span>
          </button>
        </div>
      </dialog>
    </section>
  )
}

<style>
  .grid-photos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .grid-photos li:nth-child(5n + 1) {
    grid-column: span 2;
  }

  .grid-photos a {
    display: block;
    cursor: zoom-in;
  }

  .grid-photos a:active {
    opacity: 0.8;
  }

  .grid-photos a:focus-visible {
    outline-offset: -4px;
  }

  .lightbox {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-night-950);
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
  }

  .lightbox::backdrop {
    background: var(--color-night-950);
  }

  figure {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 0;
  }

  figure img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  figcaption {
    padding: 0.5rem var(--spacing-gutter);
    color: var(--color-mute);
    font-size: var(--text-sm);
    text-align: center;
  }

  figcaption:empty {
    display: none;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem var(--spacing-gutter) max(0.5rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line);
  }

  .controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 3rem;
    min-height: 3rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-line);
    cursor: pointer;
  }

  .controls button:active {
    background: var(--color-red);
  }

  .controls .close {
    margin-left: auto;
  }

  .controls :global(.flip) {
    transform: scaleX(-1);
  }

  .controls p {
    min-width: 4ch;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .grid-photos {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }

    .grid-photos li:nth-child(5n + 1) {
      grid-row: span 2;
    }

    .grid-photos li:nth-child(5n + 1) :global(.frame) {
      height: 100%;
    }
  }
</style>
