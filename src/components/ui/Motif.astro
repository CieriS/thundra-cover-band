---
/**
 * Decorative motifs that say "AC/DC tribute" at a glance without using anything that
 * belongs to the band: devil horns, a striped school tie, a bell, a cannon and an
 * electrical hazard sign. All generic drawings, original to this site. No logo, no
 * lettering, no album artwork is reproduced.
 */
interface Props {
  name: 'horns' | 'tie' | 'bell' | 'cannon' | 'hazard';
  class?: string;
}

const { name, class: className } = Astro.props;
---

{
  name === 'horns' && (
    <svg class:list={['motif motif-horns', className]} viewBox="0 0 120 50" aria-hidden="true" focusable="false">
      <path d="M34 50C10 44 0 24 6 0c6 16 18 26 38 30z" fill="var(--color-red)" />
      <path d="M86 50c24-6 34-26 28-50-6 16-18 26-38 30z" fill="var(--color-red)" />
    </svg>
  )
}
{
  name === 'tie' && (
    <svg class:list={['motif motif-tie', className]} viewBox="0 0 60 210" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="tie-stripes" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)">
          <rect width="14" height="14" fill="var(--color-night-700)" />
          <rect width="14" height="5" fill="var(--color-red)" />
          <rect y="5" width="14" height="1.2" fill="var(--color-bone)" />
        </pattern>
      </defs>
      <path d="M18 0h24l-5 24H23z" fill="var(--color-red-deep)" />
      <path d="M23 24h14l13 140-20 44-20-44z" fill="url(#tie-stripes)" stroke="var(--color-night-950)" stroke-width="1.5" />
    </svg>
  )
}
{
  name === 'bell' && (
    <svg class:list={['motif motif-bell', className]} viewBox="0 0 100 120" aria-hidden="true" focusable="false">
      <g class="bell-body">
        <path d="M44 6a6 6 0 0 1 12 0v6h-12z" fill="var(--color-mute)" />
        <path
          d="M50 12c-20 0-27 20-27 44 0 20-8 30-15 36h84c-7-6-15-16-15-36 0-24-7-44-27-44z"
          fill="var(--color-night-700)"
          stroke="var(--color-bone)"
          stroke-width="3"
        />
        <path d="M14 84h72" stroke="var(--color-red)" stroke-width="4" />
      </g>
      <circle class="bell-clapper" cx="50" cy="104" r="8" fill="var(--color-bone)" />
    </svg>
  )
}
{
  name === 'cannon' && (
    <svg class:list={['motif motif-cannon', className]} viewBox="0 0 170 110" aria-hidden="true" focusable="false">
      <circle class="cannon-puff" cx="148" cy="22" r="16" fill="var(--color-bone)" />
      <g class="cannon-body">
        <rect x="34" y="34" width="104" height="26" rx="5" transform="rotate(-20 50 50)" fill="var(--color-night-950)" />
        <rect x="126" y="6" width="10" height="34" rx="2" transform="rotate(-20 50 50)" fill="var(--color-night-950)" />
        <circle cx="50" cy="74" r="30" fill="none" stroke="var(--color-night-950)" stroke-width="8" />
        <path d="M50 44v60M20 74h60M29 53l42 42M71 53 29 95" stroke="var(--color-night-950)" stroke-width="4" />
        <circle cx="50" cy="74" r="7" fill="var(--color-night-950)" />
      </g>
    </svg>
  )
}
{
  name === 'hazard' && (
    <span class:list={['motif motif-hazard', className]} aria-hidden="true">
      <svg viewBox="0 0 100 90" focusable="false">
        <path d="M50 6 95 84H5z" fill="var(--color-bone)" stroke="var(--color-night-950)" stroke-width="7" stroke-linejoin="round" />
        <path d="M56 26 38 54h12l-6 22 20-30H52z" fill="var(--color-night-950)" />
      </svg>
      <span class="poster">Alta tensione</span>
    </span>
  )
}
