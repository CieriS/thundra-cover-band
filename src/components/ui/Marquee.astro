---
import { copy } from '@/config/copy';

/** Pure CSS marquee. The second copy is hidden from assistive technology. */
interface Props {
  items: readonly string[];
  /** Seconds for one full loop. */
  duration?: number;
  reverse?: boolean;
  outlined?: boolean;
  class?: string;
}

const { items, duration = 28, reverse = false, outlined = false, class: className } = Astro.props;

// Repeat short lists so one copy is always wider than the viewport.
const repeat = Math.max(1, Math.ceil(8 / Math.max(1, items.length)));
const track = Array.from({ length: repeat }, () => items).flat();
---

<div class:list={['marquee', className]} data-marquee>
  <label class="pause">
    <input class="visually-hidden" type="checkbox" />
    <span class="pause-box" aria-hidden="true">
      <svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18"><path d="M7 5h3.5v14H7zM13.500 5H17v14h-3.500z" fill="currentColor" /></svg>
      <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
    </span>
    <span class="visually-hidden">{copy.ui.pauseMarquee}</span>
  </label>
  {
    [false, true].map((copy) => (
      <ul
        class:list={['marquee-track poster', reverse && 'is-reverse', outlined && 'outline-type']}
        style={`--marquee-duration: ${duration}s`}
        aria-hidden={copy ? 'true' : undefined}
      >
        {track.map((item) => (
          <li>
            {item}
            <span class="sep" aria-hidden="true" />
          </li>
        ))}
      </ul>
    ))
  }
</div>

<style>
  .marquee {
    position: relative;
    display: flex;
    overflow: hidden;
  }

  /*
   * Moving content needs a way to stop it (WCAG 2.2.2): a checkbox, so it works without
   * JavaScript, drawn as a small pause/play button in the corner.
   */
  .pause {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    translate: 0 -50%;
    cursor: pointer;
  }

  .pause-box {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-line);
    background: var(--color-night-950);
    color: var(--color-bone);
  }

  .icon-play,
  .pause:has(input:checked) .icon-pause {
    display: none;
  }

  .pause:has(input:checked) .icon-play {
    display: block;
  }

  .pause:has(input:focus-visible) .pause-box {
    outline: 3px solid var(--color-volt);
    outline-offset: 2px;
  }

  .marquee:has(.pause input:checked) .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .pause {
      display: none;
    }
  }

  .marquee-track {
    display: flex;
    flex-shrink: 0;
    min-width: 100%;
    font-size: var(--text-4xl);
    line-height: 1.1;
    white-space: nowrap;
    animation: marquee var(--marquee-duration) linear infinite;
  }

  .marquee-track.is-reverse {
    animation-direction: reverse;
  }

  li {
    display: flex;
    align-items: center;
  }

  /* Slanted red slash between items. */
  /* Slanted red slash between items. */
  .sep {
    flex-shrink: 0;
    width: 0.14em;
    height: 0.68em;
    margin-inline: 0.4em;
    background: var(--color-red);
    transform: skewX(-18deg);
  }

  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
