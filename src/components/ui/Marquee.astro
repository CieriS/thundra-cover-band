---
/** Pure CSS marquee. The second copy is hidden from assistive technology. */
interface Props {
  items: readonly string[];
  /** Seconds for one full loop. */
  duration?: number;
  reverse?: boolean;
  outlined?: boolean;
  class?: string;
}

const { items, duration = 28, reverse = false, outlined = false, class: className } = Astro.props;

// Repeat short lists so one copy is always wider than the viewport.
const repeat = Math.max(1, Math.ceil(8 / Math.max(1, items.length)));
const track = Array.from({ length: repeat }, () => items).flat();
---

<div class:list={['marquee', className]} data-marquee>
  <label class="pause label">
    <input type="checkbox" />
    <span>Ferma lo scorrimento</span>
  </label>
  {
    [false, true].map((copy) => (
      <ul
        class:list={['marquee-track poster', reverse && 'is-reverse', outlined && 'outline-type']}
        style={`--marquee-duration: ${duration}s`}
        aria-hidden={copy ? 'true' : undefined}
      >
        {track.map((item) => (
          <li>
            {item}
            <span class="sep" aria-hidden="true" />
          </li>
        ))}
      </ul>
    ))
  }
</div>

<style>
  .marquee {
    position: relative;
    display: flex;
    overflow: hidden;
    padding-bottom: 3rem;
  }

  /* Moving content needs a way to stop it: a checkbox, so it works without JavaScript. */
  .pause {
    position: absolute;
    right: var(--spacing-gutter);
    bottom: 0;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    color: var(--color-mute);
    cursor: pointer;
  }

  .pause input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--color-red);
  }

  .marquee:has(.pause input:checked) .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .pause {
      display: none;
    }

    .marquee {
      padding-bottom: 0;
    }
  }

  .marquee-track {
    display: flex;
    flex-shrink: 0;
    min-width: 100%;
    font-size: var(--text-4xl);
    line-height: 1.1;
    white-space: nowrap;
    animation: marquee var(--marquee-duration) linear infinite;
  }

  .marquee-track.is-reverse {
    animation-direction: reverse;
  }

  li {
    display: flex;
    align-items: center;
  }

  /* Slanted red slash between items. */
  /* Slanted red slash between items. */
  .sep {
    flex-shrink: 0;
    width: 0.14em;
    height: 0.68em;
    margin-inline: 0.4em;
    background: var(--color-red);
    transform: skewX(-18deg);
  }

  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
