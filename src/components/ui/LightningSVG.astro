---
/**
 * Decorative bolt drawn with stroke-dashoffset when it enters the viewport.
 * Generic shape, unrelated to any logo. The glow is a pre-blurred copy whose
 * opacity is animated: no filter is animated at runtime.
 */
interface Props {
  variant?: 'a' | 'b' | 'c';
  class?: string;
}

const { variant = 'a', class: className } = Astro.props;

const paths = {
  a: 'M70 2 38 78l22 4-34 70 26 6-40 92',
  b: 'M24 2l30 62-24 8 44 74-28 8 38 96',
  c: 'M52 2 30 58l30 6-42 66 30 8-28 110',
} as const;
---

<svg
  class:list={['bolt', className]}
  viewBox="0 0 96 252"
  fill="none"
  aria-hidden="true"
  focusable="false"
  data-reveal="bolt"
>
  <path class="bolt-glow" d={paths[variant]} pathLength="1"></path>
  <path class="bolt-core" d={paths[variant]} pathLength="1"></path>
</svg>

<style>
  .bolt {
    pointer-events: none;
    overflow: visible;
  }

  .bolt path {
    stroke-linecap: square;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }

  .bolt-core {
    stroke: var(--color-volt);
    stroke-width: 2.5;
  }

  .bolt-glow {
    stroke: var(--color-volt);
    stroke-width: 12;
    filter: blur(7px);
    opacity: 0;
  }
</style>
