---
/**
 * Decorative bolt. When the band logo is available its own bolt is used (the vector
 * shape traced from the logo) and it strikes downwards;
 * otherwise a generic line bolt is drawn with stroke-dashoffset. The glow is a pre-blurred copy whose
 * opacity is animated: no filter is animated at runtime.
 */
import { logoPaths } from '@/config/logo-paths';

interface Props {
  variant?: 'a' | 'b' | 'c';
  class?: string;
}

const { variant = 'a', class: className } = Astro.props;
const logoBolt = logoPaths.bolt;

const paths = {
  a: 'M70 2 38 78l22 4-34 70 26 6-40 92',
  b: 'M24 2l30 62-24 8 44 74-28 8 38 96',
  c: 'M52 2 30 58l30 6-42 66 30 8-28 110',
} as const;
---

{
  logoBolt ? (
    <svg
      class:list={['bolt bolt-logo', className]}
      viewBox={`${logoBolt.x - 6} ${logoBolt.y - 6} ${logoBolt.w + 12} ${logoBolt.h + 12}`}
      aria-hidden="true"
      focusable="false"
      data-reveal="bolt"
    >
      <path class="bolt-shape" d={logoBolt.d} />
    </svg>
  ) : (
    <svg
      class:list={['bolt', className]}
      viewBox="0 0 96 252"
      fill="none"
      aria-hidden="true"
      focusable="false"
      data-reveal="bolt"
    >
      <path class="bolt-glow" d={paths[variant]} pathLength="1"></path>
      <path class="bolt-core" d={paths[variant]} pathLength="1"></path>
    </svg>
  )
}

<style>
  .bolt {
    pointer-events: none;
    overflow: visible;
  }

  .bolt path {
    stroke-linecap: square;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }

  .bolt-core {
    stroke: var(--color-volt);
    stroke-width: 2.5;
  }

  .bolt-glow {
    stroke: var(--color-volt);
    stroke-width: 12;
    filter: blur(7px);
    opacity: 0;
  }
</style>
