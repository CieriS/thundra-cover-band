---
import RevealText from './RevealText.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: readonly string[];
  intro?: string;
  as?: 'h1' | 'h2';
  size?: 'lg' | 'xl';
  class?: string;
}

const { id, eyebrow, title, intro, as = 'h2', size = 'xl', class: className } = Astro.props;
// A page title (h1) sits above the fold: it is never hidden waiting for the reveal.
const still = as === 'h1';
---

<header class:list={['grid gap-4', className]}>
  <p class="label flex items-center gap-3 text-red-ink">
    <span class="h-px w-8 bg-red-ink" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <RevealText id={id} as={as} lines={title} still={still} class={size === 'xl' ? 'text-5xl' : 'text-4xl'} />
  {intro && <p class="max-w-xl text-lg text-mute" data-reveal={still ? undefined : 'fade'}>{intro}</p>}
</header>
