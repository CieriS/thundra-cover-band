---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS aspect-ratio of the frame, e.g. "4 / 5". The image always covers it. */
  ratio: string;
  /** `sizes` attribute: how wide the image is shown at each breakpoint. */
  sizes: string;
  widths?: number[];
  /** Only for the image above the fold: loads eagerly with high priority. */
  eager?: boolean;
  /** Diagonal clip-path reveal when scrolled into view. */
  reveal?: boolean;
  /** Shows a small "placeholder" tag over generated images. */
  placeholder?: boolean;
  class?: string;
}

const {
  src,
  alt,
  ratio,
  sizes,
  widths = [360, 640, 960, 1280, 1600],
  eager = false,
  reveal = false,
  placeholder = false,
  class: className,
} = Astro.props;

const usable = widths.filter((width) => width <= src.width);
---

<div
  class:list={['frame', className]}
  style={`aspect-ratio: ${ratio}`}
  data-reveal={reveal ? 'image' : undefined}
>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={usable.length > 0 ? usable : [src.width]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
  />
  {placeholder && <span class="tag">Segnaposto</span>}
</div>

<style>
  .frame {
    position: relative;
    /* clip, not hidden: hidden would make the frame a scroll container and freeze
       the scroll-driven animations of what is inside. */
    overflow: clip;
    background: var(--color-night-800);
  }

  /* The picture fills the frame so that clip-path reveals have a real box to clip. */
  .frame :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tag {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.15rem 0.5rem;
    background: var(--color-night-950);
    color: var(--color-volt);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
