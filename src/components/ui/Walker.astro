---
/**
 * A guitarist in cap, tie and shorts who walks across the page as it scrolls: the stage
 * move every hard-rock fan recognises. Original cartoon figure with a dark outline, not a
 * portrait of anyone. Limbs are polylines drawn twice (outline under colour). Decorative: hidden from assistive technology.
 * The walk is driven by scroll (two leg poses alternate); without scroll-driven
 * animations, or with reduced motion, the figure simply stands in the middle.
 */
---

<div class="walker-lane" aria-hidden="true">
  <div class="walker">
    <svg class="walker-hop" viewBox="40 20 230 236" focusable="false">
      <g fill="none" stroke-linecap="round" stroke-linejoin="round">
        <g class="frame-a">
        <path d="M124 156 136 198 118 232" stroke="var(--color-night-950)" stroke-width="24"/><path d="M124 156 136 198 118 232" stroke="var(--color-bone)" stroke-width="17"/>
        <path d="M127 214 118 232" stroke="var(--color-night-950)" stroke-width="24"/><path d="M127 214 118 232" stroke="var(--color-bone)" stroke-width="17"/><path d="M131 204 121 224" stroke="var(--color-red)" stroke-width="5"/>
        <ellipse cx="124" cy="240" rx="16" ry="8.500" transform="rotate(0 124 240)" fill="var(--color-night-950)" stroke="var(--color-bone)" stroke-width="3.500"/>
        <path d="M148 158 190 168 222 158" stroke="var(--color-night-950)" stroke-width="24"/><path d="M148 158 190 168 222 158" stroke="var(--color-bone)" stroke-width="17"/>
        <path d="M200 166 214 161" stroke="var(--color-red)" stroke-width="5"/>
        <ellipse cx="232" cy="154" rx="16" ry="8.500" transform="rotate(-18 232 154)" fill="var(--color-night-950)" stroke="var(--color-bone)" stroke-width="3.500"/>
        </g>
        <g class="frame-b">
        <path d="M124 156 96 184 70 170" stroke="var(--color-night-950)" stroke-width="24"/><path d="M124 156 96 184 70 170" stroke="var(--color-bone)" stroke-width="17"/>
        <path d="M88 180 76 174" stroke="var(--color-red)" stroke-width="5"/>
        <ellipse cx="62" cy="166" rx="16" ry="8.500" transform="rotate(28 62 166)" fill="var(--color-night-950)" stroke="var(--color-bone)" stroke-width="3.500"/>
        <path d="M148 158 164 198 150 232" stroke="var(--color-night-950)" stroke-width="24"/><path d="M148 158 164 198 150 232" stroke="var(--color-bone)" stroke-width="17"/>
        <path d="M161 206 153 224" stroke="var(--color-red)" stroke-width="5"/>
        <ellipse cx="156" cy="240" rx="16" ry="8.500" transform="rotate(0 156 240)" fill="var(--color-night-950)" stroke="var(--color-bone)" stroke-width="3.500"/>
        </g>
        <path d="M132 96 114 128 138 142" stroke="var(--color-night-950)" stroke-width="20"/><path d="M132 96 114 128 138 142" stroke="var(--color-red)" stroke-width="13"/>
        <path d="M112 138 158 142 164 172 140 176 136 162 130 176 106 170z" fill="var(--color-red-deep)" stroke="var(--color-night-950)" stroke-width="3.500" stroke-linejoin="round"/>
        <path d="M126 82 170 86 166 150 112 146z" fill="var(--color-red)" stroke="var(--color-night-950)" stroke-width="3.500" stroke-linejoin="round"/>
        <path d="M146 84 152 110 160 86z" fill="var(--color-bone)" stroke="var(--color-night-950)" stroke-width="2.500" stroke-linejoin="round"/>
        <path d="M150 88 120 100 124 110 152 98z" fill="var(--color-night-950)" stroke="var(--color-bone)" stroke-width="2.500" stroke-linejoin="round"/>
        <path d="M158 126 240 78" stroke="var(--color-night-950)" stroke-width="13"/><path d="M158 126 240 78" stroke="var(--color-bone)" stroke-width="7"/>
        <path d="M236 70 254 60 260 72 242 84z" fill="var(--color-bone)" stroke="var(--color-night-950)" stroke-width="3" stroke-linejoin="round"/>
        <path d="M110 134 124 112 136 128 150 118 162 134 156 154 136 164 114 154z" fill="var(--color-night-700)" stroke="var(--color-bone)" stroke-width="4" stroke-linejoin="round"/>
        <path d="M164 96 190 118 210 100" stroke="var(--color-night-950)" stroke-width="20"/><path d="M164 96 190 118 210 100" stroke="var(--color-red)" stroke-width="13"/>
        <circle cx="212" cy="97" r="8" fill="var(--color-bone)" stroke="var(--color-night-950)" stroke-width="3"/>
        <circle cx="140" cy="143" r="8" fill="var(--color-bone)" stroke="var(--color-night-950)" stroke-width="3"/>
        <path d="M132 40q-18 10-12 34 14-8 20-26z" fill="var(--color-bone)" stroke="var(--color-night-950)" stroke-width="3" stroke-linejoin="round"/>
        <circle cx="152" cy="58" r="21" fill="var(--color-bone)" stroke="var(--color-night-950)" stroke-width="3.500"/>
        <path d="M130 52Q150 18 176 44L198 52 196 61 130 59z" fill="var(--color-red)" stroke="var(--color-night-950)" stroke-width="3.500" stroke-linejoin="round"/>
        <path d="M132 53h44" stroke="var(--color-night-950)" stroke-width="3"/>
        <circle cx="162" cy="66" r="2.500" fill="var(--color-night-950)"/>
      </g>
    </svg>
  </div>
</div>

<style>
  .walker-lane {
    position: relative;
    height: clamp(9rem, 22vw, 15rem);
    /* clip, not hidden: the walker's scroll timeline must be the page, not this lane. */
    overflow: clip;
    background: linear-gradient(to bottom, var(--color-night-950), var(--color-night-800));
  }

  .walker {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: clamp(8rem, 20vw, 14rem);
    translate: -50% 0;
  }

  .walker svg {
    display: block;
  }

  .frame-b {
    opacity: 0;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .walker {
        left: 0;
        translate: none;
        animation: walk-across linear both;
        animation-timeline: view() !important;
        animation-range: entry 20% exit 80%;
      }

      .walker-hop {
        animation: walk-hop linear both;
        animation-timeline: view() !important;
        animation-range: entry 20% exit 80%;
      }

      .frame-a {
        animation: walk-a steps(1, end) both;
        animation-timeline: view() !important;
        animation-range: entry 20% exit 80%;
      }

      .frame-b {
        animation: walk-b steps(1, end) both;
        animation-timeline: view() !important;
        animation-range: entry 20% exit 80%;
      }
    }
  }

  @keyframes walk-across {
    from {
      transform: translateX(-110%);
    }

    to {
      transform: translateX(100vw);
    }
  }

  @keyframes walk-hop {
    0%, 20%, 40%, 60%, 80%, 100% {
      transform: translateY(0);
    }

    10%, 30%, 50%, 70%, 90% {
      transform: translateY(-7%);
    }
  }

  @keyframes walk-a {
    0%, 20%, 40%, 60%, 80% {
      opacity: 1;
    }

    10%, 30%, 50%, 70%, 90% {
      opacity: 0;
    }
  }

  @keyframes walk-b {
    0%, 20%, 40%, 60%, 80% {
      opacity: 0;
    }

    10%, 30%, 50%, 70%, 90% {
      opacity: 1;
    }
  }
</style>
