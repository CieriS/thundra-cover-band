---
import { copy } from '@/config/copy';
import type { EventEntry } from '@/lib/content';
import { dateParts } from '@/lib/dates';
import { admissionLabel, mapsUrl, placeLabel } from '@/lib/events';
import Icon from './Icon.astro';

interface Props {
  event: EventEntry;
  /** Archive cards have no actions. */
  past?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { event, past = false, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = event;
const date = dateParts(data.date);
const admission = admissionLabel(data);
const cancelled = data.status === 'cancelled';
const statusLabel = cancelled ? 'Annullato' : data.status === 'postponed' ? 'Rinviato' : null;
---

<article class:list={['event', past && 'is-past', cancelled && 'is-cancelled']} id={event.id}>
  <time class="date poster" datetime={data.date}>
    <span class="day">{date.day}</span>
    <span class="month">
      {date.month}
      <span class="year">{date.year}</span>
    </span>
    <span class="visually-hidden">, {date.weekday}</span>
  </time>

  <div class="body">
    <p class="label text-red-ink" aria-hidden="true">{date.weekday}</p>
    <Heading class="poster venue">{data.venue}</Heading>
    <p class="poster city">{placeLabel(data)}</p>
    <ul class="meta">
      {statusLabel && <li class="status">{statusLabel}</li>}
      {!past && <li>{data.time ? `Inizio ore ${data.time}` : copy.nextShow.timeUnknown}</li>}
      {!past && admission && <li>{admission}</li>}
      {data.address && <li>{data.address}</li>}
      {data.note && <li>{data.note}</li>}
    </ul>
  </div>

  {
    !past && !cancelled && (
      <ul class="actions">
        <li>
          <a href={`/date/${event.id}.ics`} download>
            <Icon name="calendar" />
            {copy.nextShow.calendar}
          </a>
        </li>
        <li>
          <a href={mapsUrl(data)} target="_blank" rel="noopener noreferrer">
            <Icon name="pin" />
            {copy.nextShow.directions}
            <span class="visually-hidden"> (apre Google Maps in una nuova scheda)</span>
          </a>
        </li>
        {data.bookingUrl && (
          <li>
            <a class="is-primary" href={data.bookingUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="ticket" />
              {data.bookingLabel ?? 'Prenota'}
              <span class="visually-hidden"> (apre una nuova scheda)</span>
            </a>
          </li>
        )}
      </ul>
    )
  }
  <span class="glow" aria-hidden="true"></span>
</article>

<style>
  .event {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-red);
    background: var(--color-night-900);
    scroll-margin-top: 6rem;
  }

  .date {
    display: grid;
    align-content: start;
    color: var(--color-bone);
  }

  .day {
    font-size: clamp(4.5rem, 22vw, 8rem);
    line-height: 0.8;
    letter-spacing: -0.01em;
  }

  .month {
    margin-top: 0.4rem;
    color: var(--color-red-ink);
    font-size: clamp(1.5rem, 7vw, 2.25rem);
    line-height: 1;
  }

  .year {
    color: var(--color-mute);
    font-size: 0.6em;
  }

  .body {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    min-width: 0;
  }

  .venue {
    font-size: var(--text-2xl);
    line-height: 0.95;
    overflow-wrap: anywhere;
  }

  .city {
    color: var(--color-volt);
    font-size: var(--text-xl);
    line-height: 1;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1rem;
    margin-top: 0.4rem;
    color: var(--color-mute);
    font-size: var(--text-sm);
  }

  .status {
    color: var(--color-red-ink);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .actions li {
    flex: 1 1 auto;
  }

  .actions a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.875rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-line);
    background: var(--color-night-800);
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      background-color var(--duration-fast) linear,
      border-color var(--duration-fast) linear;
  }

  .actions a.is-primary {
    border-color: var(--color-red);
    background: var(--color-red);
  }

  .actions a:active {
    background: var(--color-red);
    border-color: var(--color-red);
  }

  .is-past {
    border-left-color: var(--color-line);
  }

  .is-past .day,
  .is-cancelled .day {
    color: var(--color-mute);
  }

  .is-cancelled .venue {
    text-decoration: line-through;
  }

  .glow {
    display: none;
  }

  @media (min-width: 48rem) {
    .event {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 2rem;
      padding: 1.75rem 2rem;
    }

    .actions {
      grid-column: auto;
      flex-direction: column;
      min-width: 15rem;
    }
  }
</style>
