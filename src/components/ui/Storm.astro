---
/**
 * Branching lightning behind the hero logo, like the band's artwork. The bolts are generated
 * at build time (seeded, so every build draws the same storm), drawn with stroke-dashoffset in
 * two quick strikes when the page opens, then they stay as faint cracks in the sky.
 * Decorative. Two flashes in total, thin lines only: nothing blinks, nothing fills the screen.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Small deterministic generator (mulberry32): same seed, same storm.
function random(seed: number) {
  let state = seed;
  return () => {
    state |= 0;
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

type Point = [number, number];

/** Jagged line between two points by midpoint displacement. */
function jagged(from: Point, to: Point, roughness: number, next: () => number, depth = 5): Point[] {
  if (depth === 0) return [from, to];
  const mid: Point = [
    (from[0] + to[0]) / 2 + (next() - 0.5) * roughness,
    (from[1] + to[1]) / 2 + (next() - 0.5) * roughness,
  ];
  return [...jagged(from, mid, roughness / 2, next, depth - 1).slice(0, -1), ...jagged(mid, to, roughness / 2, next, depth - 1)];
}

const toPath = (points: Point[]) => `M${points.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L')}`;

// Each bolt leaves the centre (behind the logo) for a corner or an edge, with a few branches.
const next = random(20261031);
const centre: Point = [50, 52];
const targets: Point[] = [
  [-4, 4],
  [104, -2],
  [-6, 92],
  [106, 86],
  [62, -6],
  [30, 108],
];
const bolts = targets.map((target, index) => {
  const trunk = jagged(centre, target, 16, next);
  const branches = [0.35, 0.6].map((at) => {
    const origin = trunk[Math.floor(trunk.length * at)] ?? centre;
    const end: Point = [origin[0] + (next() - 0.5) * 46, origin[1] + (next() - 0.5) * 46];
    return toPath(jagged(origin, end, 9, next, 4));
  });
  return { d: [toPath(trunk), ...branches].join(''), strike: index % 2 };
});
---

<svg class:list={['storm', className]} viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
  {
    bolts.map((bolt) => (
      <g class={`storm-bolt strike-${bolt.strike}`}>
        <path class="storm-glow" d={bolt.d} pathLength="1" />
        <path class="storm-core" d={bolt.d} pathLength="1" />
      </g>
    ))
  }
</svg>

<style>
  .storm {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .storm path {
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }

  .storm-core {
    stroke: #e8f6ff;
    stroke-width: 1.4;
  }

  /* Pre-blurred copy for the glow: the blur is static, only opacity changes. */
  .storm-glow {
    stroke: var(--color-volt);
    stroke-width: 7;
    filter: blur(5px);
  }

  /* At rest (and without motion): faint cracks in the sky. */
  .storm-bolt {
    opacity: 0.22;
  }

  @media (prefers-reduced-motion: no-preference) {
    .storm-bolt path {
      stroke-dasharray: 1;
      animation: storm-draw 260ms cubic-bezier(0.6, 0, 1, 0.6) both;
    }

    .storm-bolt {
      animation: storm-flash 1100ms ease-out both;
    }

    .strike-0,
    .strike-0 path {
      animation-delay: 820ms;
    }

    .strike-1,
    .strike-1 path {
      animation-delay: 1500ms;
    }
  }

  @keyframes storm-draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  /* One peak per strike, then it settles: two peaks in the whole sequence. */
  @keyframes storm-flash {
    0% {
      opacity: 0;
    }

    18% {
      opacity: 1;
    }

    100% {
      opacity: 0.22;
    }
  }
</style>
