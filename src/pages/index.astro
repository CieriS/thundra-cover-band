---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Band from '@/components/sections/Band.astro';
import Booking from '@/components/sections/Booking.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Gallery from '@/components/sections/Gallery.astro';
import Hero from '@/components/sections/Hero.astro';
import HazardStripe from '@/components/ui/HazardStripe.astro';
import Marquee from '@/components/ui/Marquee.astro';
import Walker from '@/components/ui/Walker.astro';
import Live from '@/components/sections/Live.astro';
import NextShow from '@/components/sections/NextShow.astro';
import Reviews from '@/components/sections/Reviews.astro';
import Setlist from '@/components/sections/Setlist.astro';
import Social from '@/components/sections/Social.astro';
import Tour from '@/components/sections/Tour.astro';
import { getEvents, getSetlist } from '@/lib/content';
import { bandJsonLd, eventsJsonLd, siteJsonLd } from '@/lib/seo';

const { upcoming, next } = await getEvents();
// Song titles only (never lyrics), shortened at the first bracket.
const songs = ((await getSetlist())?.data.songs ?? []).map((song) => song.split(' (')[0] ?? song);
const jsonLd = [siteJsonLd(Astro.site!), await bandJsonLd(Astro.site!), ...(await eventsJsonLd(upcoming, Astro.site!))];
---

<BaseLayout jsonLd={jsonLd} hasHero>
  <Hero next={next} />
  <HazardStripe />
  {next && <NextShow event={next} />}
  <Tour events={upcoming} />
  <Live />
  <Reviews />
  <Band />
  {songs.length > 0 && <Marquee items={songs} duration={60} class="songs-marquee" />}
  <Setlist />
  <Walker />
  <HazardStripe />
  <Booking />
  <Gallery />
  <Social />
  <FinalCTA />
</BaseLayout>
