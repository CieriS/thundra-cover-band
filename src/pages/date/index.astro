---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { copy } from '@/config/copy';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Tour from '@/components/sections/Tour.astro';
import { getEvents } from '@/lib/content';
import { eventsJsonLd, seoText } from '@/lib/seo';

const { upcoming } = await getEvents();
---

<BaseLayout
  {...seoText(copy.seo.dates)}
  jsonLd={await eventsJsonLd(upcoming, Astro.site!)}
>
  <Tour events={upcoming} page />
  <FinalCTA />
</BaseLayout>
