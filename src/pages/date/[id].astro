---
/**
 * One page per date, built from the same file in src/content/events/ that feeds the lists:
 * adding a date creates its page, its calendar file and its entry in the sitemap.
 * Past dates keep their page (with a note), so links shared before the show never break.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Button from '@/components/ui/Button.astro';
import Countdown from '@/components/ui/Countdown.astro';
import EventCard from '@/components/ui/EventCard.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { copy } from '@/config/copy';
import { site } from '@/config/site';
import { whatsappShareUrl } from '@/lib/contact';
import { getEvents, getPublicEvents, today, type EventEntry } from '@/lib/content';
import { countdownTarget, eventPath, isPast } from '@/lib/events';
import { flyerFiles } from '@/lib/flyer/layout';
import { eventsJsonLd, eventValues, seoText, seoValues } from '@/lib/seo';
import { fill } from '@/lib/text';

export const getStaticPaths: GetStaticPaths = async () =>
  (await getPublicEvents()).map((event) => ({ params: { id: event.id }, props: { event } }));

interface Props {
  event: EventEntry;
}

const { event } = Astro.props;
const { data } = event;
const values = { ...seoValues, ...eventValues(event) };
const past = isPast(event, today());
const { upcoming } = await getEvents();
const others = upcoming.filter((other) => other.id !== event.id).slice(0, 3);
const flyer = flyerFiles(event.id);
const invite = [copy.nextShow.shareMessage, `${values.dateLong}, ${data.venue}, ${values.place}`, new URL(eventPath(event.id), Astro.site).href].join('\n');
---

<BaseLayout {...seoText(copy.seo.event, eventValues(event))} jsonLd={await eventsJsonLd([event], Astro.site!)} image={flyer.preview}>
  <section class="section" aria-labelledby="concerto-title">
    <div class="wrap grid gap-8">
      <SectionHeading
        id="concerto-title"
        as="h1"
        eyebrow={`${copy.event.eyebrow} · ${values.dateShort}`}
        title={[copy.event.titlePrefix, data.venue]}
        intro={fill(copy.event.intro, values)}
        size="lg"
      />

      {past && <p class="note">{copy.event.past}</p>}

      <EventCard event={event} past={past} headingLevel="h2" link={false} />

      {
        !past && data.status !== 'cancelled' && (
          <div class="grid gap-6">
            <Countdown target={countdownTarget(data, site.timeZone)} dayOnly={!data.time} />
            <p>
              <Button href={whatsappShareUrl(invite)} variant="ghost" target="_blank" rel="noopener noreferrer">
                <Icon name="chat" />
                {copy.nextShow.share}
                <span class="visually-hidden"> {copy.ui.opensNewTab}</span>
              </Button>
            </p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section poster-block" aria-labelledby="locandina-title">
    <div class="wrap poster-layout">
      <div class="poster-head grid gap-3">
        <h2 id="locandina-title" class="poster text-3xl">{copy.flyer.blockTitle}</h2>
        <p class="text-mute">{copy.flyer.blockText}</p>
      </div>
      <a class="poster-image" href={flyer.a4} download>
        <img
          src={flyer.thumbnail}
          alt={fill(copy.flyer.alt, values)}
          width="640"
          height="905"
          loading="lazy"
          decoding="async"
        />
      </a>
      <ul class="poster-actions grid gap-3">
        <li>
          <Button href={flyer.pdf} download block>
            <Icon name="download" />
            {copy.flyer.pdf}
          </Button>
        </li>
        <li>
          <Button href={flyer.a4} variant="outline" download block>
            <Icon name="download" />
            {copy.flyer.image}
          </Button>
        </li>
        <li>
          <Button href={flyer.instagram} variant="ghost" download block>
            <Icon name="instagram" />
            {copy.flyer.instagram}
          </Button>
        </li>
      </ul>
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="section others" aria-labelledby="altre-title">
        <div class="wrap grid gap-6">
          <h2 id="altre-title" class="poster text-3xl">
            {copy.event.others}
          </h2>
          <ol class="grid gap-4">
            {others.map((other) => (
              <li>
                <EventCard event={other} />
              </li>
            ))}
          </ol>
          <p>
            <Button href="/date/" variant="outline">
              {copy.event.allDates}
            </Button>
          </p>
        </div>
      </section>
    )
  }
  <FinalCTA />
</BaseLayout>

<style>
  .note {
    padding: 0.9rem 1.1rem;
    border-left: 4px solid var(--color-volt);
    background: var(--color-night-800);
    font-weight: 600;
  }

  .poster-block {
    background: var(--color-night-800);
  }

  .poster-layout {
    display: grid;
    gap: 2rem;
  }

  /* The sheet as a small poster, slightly tilted like the review cards. */
  .poster-image {
    display: block;
    justify-self: center;
    width: min(100%, 20rem);
    border: 1px solid var(--color-line);
    rotate: -1.5deg;
  }

  .poster-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Wide screens: the sheet on the left, title and downloads next to it. */
  @media (min-width: 48rem) {
    .poster-layout {
      grid-template-columns: auto minmax(0, 24rem);
      grid-template-rows: auto auto;
      align-content: center;
      justify-content: center;
      column-gap: 4rem;
    }

    .poster-image {
      grid-row: 1 / span 2;
      align-self: center;
    }

    .poster-head {
      align-self: end;
    }

    .poster-actions {
      align-self: start;
    }
  }

  .others {
    background: var(--color-night-900);
  }
</style>
