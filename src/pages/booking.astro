---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { copy } from '@/config/copy';
import Booking from '@/components/sections/Booking.astro';
import Live from '@/components/sections/Live.astro';
import Reviews from '@/components/sections/Reviews.astro';
import Setlist from '@/components/sections/Setlist.astro';
import { bandJsonLd, seoText } from '@/lib/seo';

---

<BaseLayout
  {...seoText(copy.seo.booking)}
  jsonLd={[await bandJsonLd(Astro.site!)]}
>
  <Booking page />
  <Reviews />
  <Live />
  <Setlist />
</BaseLayout>
