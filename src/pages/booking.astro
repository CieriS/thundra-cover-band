---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Booking from '@/components/sections/Booking.astro';
import Live from '@/components/sections/Live.astro';
import Reviews from '@/components/sections/Reviews.astro';
import Setlist from '@/components/sections/Setlist.astro';
import { site } from '@/config/site';
import { bandJsonLd } from '@/lib/seo';

const area = site.area.cities.join(', ');
---

<BaseLayout
  title="Booking: porta Thundra nel tuo locale"
  description={`Ingaggia ${site.name}, tributo agli AC/DC, per il tuo locale o il tuo evento tra ${area} ${site.area.note}: show di ${site.show.durationLabel}, scheda tecnica e contatto diretto su WhatsApp.`}
  jsonLd={[await bandJsonLd(Astro.site!)]}
>
  <Booking page />
  <Reviews />
  <Live />
  <Setlist />
</BaseLayout>
